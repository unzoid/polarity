{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-window",
  "description": "Main window on desktop: the player's Pin window (#266) keeps it on top and stops moving and resizing it; its Picture in Picture shrinks it into a corner and puts it back",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-resizable",
    "core:window:allow-set-minimizable",
    "core:window:allow-set-maximizable",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-min-size",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polarity",
  "version": "0.19.0",
  "identifier": "app.getpolar.desktop",
  "build": {
    "beforeDevCommand": "bun scripts/fetch-mpv.ts --dev && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun scripts/fetch-mpv.ts && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Polarity",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://challenges.cloudflare.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "media-src": "'self' data: blob: https: http:",
        "font-src": "'self' data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost https://graphql.anilist.co https://api.trakt.tv https://api.simkl.com https://api.ani.zip https://api.aniskip.com https://v3.sg.media-imdb.com https://api.github.com https://raw.githubusercontent.com https://*.supabase.co wss://*.supabase.co",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "https://www.youtube-nocookie.com https://www.youtube.com https://challenges.cloudflare.com"
      }
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5MDA2MTJDQjMzOTQ5Q0YKUldUUFNUbXpMR0VBV1lvdWtnSm9hRnRBa0VGbDArZUVLV3ZVbWI1R2I5OEg1YTl5bXJxTmZiaEsK",
      "endpoints": [
        "https://github.com/unzoid/polarity/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "polarity"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "fonts/OpenDyslexic-Regular.otf": "fonts/OpenDyslexic-Regular.otf",
      "fonts/OpenDyslexic-Bold.otf": "fonts/OpenDyslexic-Bold.otf",
      "fonts/OFL.txt": "licenses/OpenDyslexic/OFL.txt",
      "fonts/InstrumentSans-OFL.txt": "licenses/Instrument Sans/OFL.txt",
      "fonts/HankenGrotesk-OFL.txt": "licenses/Hanken Grotesk/OFL.txt",
      "fonts/Onest-OFL.txt": "licenses/Onest/OFL.txt",
      "fonts/MonaSans-OFL.txt": "licenses/Mona Sans/OFL.txt"
    }
  }
}
